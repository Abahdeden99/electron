<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>E-Voting Pilkades Karang Mukti - Kec. Cipeundeuy, Kab. Subang</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono (untuk struk thermal) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome untuk Ikon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        pilkades: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Pengaturan dasar untuk pengalaman Android Kiosk / Tablet Landscape */
        * {
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0fdf4;
            overflow-x: hidden;
        }

        /* Efek tombol taktil saat disentuh */
        .btn-tactile {
            transition: transform 0.08s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.08s ease;
        }
        .btn-tactile:active {
            transform: scale(0.96);
        }

        /* Animasi kertas struk thermal keluar dari printer */
        @keyframes printPaperSlide {
            0% {
                transform: translateY(-100%);
                opacity: 0.2;
            }
            20% {
                opacity: 1;
            }
            100% {
                transform: translateY(0%);
                opacity: 1;
            }
        }

        .thermal-paper-animate {
            animation: printPaperSlide 2.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        /* Gerigi kertas struk thermal */
        .receipt-edge-bottom {
            background: linear-gradient(-45deg, transparent 8px, #ffffff 8px), 
                        linear-gradient(45deg, transparent 8px, #ffffff 8px);
            background-repeat: repeat-x;
            background-position: left bottom;
            background-size: 16px 16px;
        }

        /* CSS Khusus Cetak Fisik ke Printer Thermal 58mm (RawBT / Bluetooth Print Service Android) */
        @media print {
            body * {
                visibility: hidden !important;
            }
            #printable-thermal-receipt, #printable-thermal-receipt * {
                visibility: visible !important;
            }
            #printable-thermal-receipt {
                position: fixed !important;
                left: 0 !important;
                top: 0 !important;
                width: 58mm !important;
                margin: 0 !important;
                padding: 4mm 2mm !important;
                box-shadow: none !important;
                background: #ffffff !important;
                color: #000000 !important;
                font-size: 11px !important;
                animation: none !important;
                transform: none !important;
            }
            @page {
                size: 58mm auto;
                margin: 0mm;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-slate-100 text-slate-800">

    <!-- =====================================================================
         HEADER RESMI PILKADES KARANG MUKTI (BAR HIJAU KHAS PEMILIHAN)
         ===================================================================== -->
    <header class="bg-gradient-to-r from-pilkades-900 via-pilkades-800 to-pilkades-700 text-white shadow-lg border-b-4 border-amber-400 px-4 py-2.5 sm:px-6">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
            <!-- Kiri: Logo Kabupaten Subang & Judul Resmi -->
            <div class="flex items-center gap-3 sm:gap-4">
                <!-- Logo SVG Kabupaten Subang (Perisai Khas Karya Utama Satya Negara) -->
                <div class="w-12 h-14 sm:w-14 sm:h-16 bg-white/10 backdrop-blur-sm rounded-xl p-1.5 flex items-center justify-center border border-white/25 shadow-inner shrink-0">
                    <svg viewBox="0 0 100 115" class="w-full h-full drop-shadow">
                        <!-- Perisai Luar -->
                        <path d="M10 10 H90 V55 C90 85 50 105 50 105 C50 105 10 85 10 55 Z" fill="#047857" stroke="#fbbf24" stroke-width="5"/>
                        <!-- Bagian Atas Kuning Emas -->
                        <path d="M13 13 H87 V42 H13 Z" fill="#f59e0b"/>
                        <!-- Gunung Tangkuban Perahu / Bukit Subang -->
                        <path d="M13 42 L35 24 L52 34 L70 20 L87 42 Z" fill="#065f46"/>
                        <!-- Bintang Kejora -->
                        <polygon points="50,14 52,20 58,20 53,24 55,30 50,26 45,30 47,24 42,20 48,20" fill="#fef08a"/>
                        <!-- Gelombang Laut Pantura Subang -->
                        <path d="M16 65 Q33 58 50 65 T84 65 V76 Q67 69 50 76 T16 76 Z" fill="#38bdf8"/>
                        <!-- Padi & Kapas / Nanas Subang -->
                        <circle cx="50" cy="53" r="8" fill="#fbbf24" stroke="#ffffff" stroke-width="1.5"/>
                        <path d="M24 52 C20 68 30 84 46 92" fill="none" stroke="#fde047" stroke-width="3.5" stroke-linecap="round"/>
                        <path d="M76 52 C80 68 70 84 54 92" fill="none" stroke="#86efac" stroke-width="3.5" stroke-linecap="round"/>
                        <!-- Pita Bawah -->
                        <rect x="24" y="88" width="52" height="10" rx="3" fill="#ffffff"/>
                        <text x="50" y="95.5" font-size="6.5" font-weight="900" text-anchor="middle" fill="#064e3b">KAB. SUBANG</text>
                    </svg>
                </div>

                <div>
                    <div class="flex items-center gap-2">
                        <span class="bg-amber-400 text-pilkades-950 text-[10px] sm:text-xs font-extrabold px-2 py-0.5 rounded uppercase tracking-wider">E-Voting Resmi</span>
                        <span class="text-pilkades-100 text-xs sm:text-sm font-semibold hidden sm:inline">• TPS 001 DESA KARANG MUKTI</span>
                    </div>
                    <h1 class="text-base sm:text-xl md:text-2xl font-black tracking-tight leading-tight uppercase text-white">
                        Pemilihan Kepala Desa Karang Mukti
                    </h1>
                    <p class="text-xs sm:text-sm text-pilkades-100 font-medium">
                        Kecamatan Cipeundeuy, Kabupaten Subang, Provinsi Jawa Barat
                    </p>
                </div>
            </div>

            <!-- Kanan: Status Printer Bluetooth, Suara, Jam & Menu Panitia -->
            <div class="flex items-center gap-2 sm:gap-3 ml-auto">
                <!-- Tombol Koneksi Printer Mini Bluetooth -->
                <button id="btn-bt-status" onclick="connectBluetoothPrinter()" class="btn-tactile flex items-center gap-2 bg-pilkades-950/60 hover:bg-pilkades-950 border border-pilkades-400/40 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition">
                    <span id="bt-indicator-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <i class="fa-brands fa-bluetooth-b text-sky-300"></i>
                    <span id="bt-status-text" class="hidden md:inline">Printer BT: Siap (Auto)</span>
                </button>

                <!-- Tombol Mute / Unmute Audio Sentuh -->
                <button id="btn-audio-toggle" onclick="toggleAudio()" title="Suara Layar Sentuh" class="btn-tactile w-10 h-10 rounded-xl bg-white/15 hover:bg-white/25 border border-white/20 flex items-center justify-center text-white">
                    <i id="audio-icon" class="fa-solid fa-volume-high text-base"></i>
                </button>

                <!-- Tombol Panel Panitia KPPS -->
                <button onclick="openCommitteeModal()" title="Panel Panitia & Unggah Foto JPG" class="btn-tactile flex items-center gap-1.5 bg-amber-500 hover:bg-amber-400 text-pilkades-950 font-bold px-3 py-2 rounded-xl text-xs sm:text-sm shadow">
                    <i class="fa-solid fa-user-shield"></i>
                    <span class="hidden sm:inline">Panitia</span>
                </button>
            </div>
        </div>
    </header>

    <!-- =====================================================================
         KONTEN UTAMA (DINAMIS: LAYAR LOGIN NIK -> BILIK SUARA -> CETAK STRUK)
         ===================================================================== -->
    <main class="flex-1 flex items-center justify-center p-3 sm:p-5 max-w-7xl w-full mx-auto">

        <!-- -----------------------------------------------------------------
             SCREEN 1: LAYAR VERIFIKASI PEMILIH (INPUT NIK / NO. UNDANGAN)
             Dioptimalkan untuk Android Landscape dengan Numpad Besar
             ----------------------------------------------------------------- -->
        <section id="screen-login" class="w-full bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden grid grid-cols-1 lg:grid-cols-12">
            
            <!-- Kolom Kiri (7 Kolom di Landscape): Instruksi & Kotak Input NIK / Undangan -->
            <div class="lg:col-span-7 p-5 sm:p-8 flex flex-col justify-between bg-gradient-to-br from-white via-pilkades-50/40 to-emerald-50/70 border-b lg:border-b-0 lg:border-r border-slate-200">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pilkades-100 text-pilkades-800 text-xs font-bold mb-3">
                        <i class="fa-solid fa-id-card"></i>
                        <span>TAHAP 1: VERIFIKASI HAK PILIH</span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
                        Selamat Datang di Bilik Suara Digital
                    </h2>
                    <p class="text-slate-600 text-sm sm:text-base mt-1.5">
                        Silakan masukkan <strong>16 Digit NIK</strong> atau <strong>Nomor Undangan (C6)</strong> Anda menggunakan papan angka di samping untuk membuka Surat Suara.
                    </p>

                    <!-- Input Display Box -->
                    <div class="mt-6">
                        <div class="flex items-center justify-between mb-1.5">
                            <label for="voter-id-input" class="text-xs font-bold uppercase tracking-wider text-pilkades-800">
                                NIK / Nomor Undangan Pemilih
                            </label>
                            <span id="digit-counter" class="text-xs font-mono font-semibold text-slate-500">0 / 16 Digit</span>
                        </div>
                        
                        <div class="relative flex items-center">
                            <input 
                                type="text" 
                                id="voter-id-input" 
                                readonly 
                                placeholder="Contoh: 3213081205850001"
                                class="w-full text-2xl sm:text-3xl font-mono font-bold tracking-widest text-pilkades-900 bg-white border-2 border-pilkades-600 focus:border-pilkades-700 rounded-2xl px-4 py-4 pr-14 shadow-inner outline-none"
                            >
                            <button onclick="clearInput()" title="Bersihkan" class="btn-tactile absolute right-3 w-10 h-10 rounded-xl bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 flex items-center justify-center">
                                <i class="fa-solid fa-xmark text-lg"></i>
                            </button>
                        </div>

                        <!-- Pesan Error / Status Validasi -->
                        <div id="login-alert" class="hidden mt-3 p-3 rounded-xl text-sm font-semibold flex items-center gap-2"></div>
                    </div>
                </div>

                <!-- Bagian Bawah Kiri: Tombol Demo Cepat & Info Waktu -->
                <div class="mt-6 pt-4 border-t border-slate-200/80 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-xs font-semibold text-slate-500">Uji Coba Cepat:</span>
                        <button onclick="fillDemoNIK()" class="btn-tactile text-xs font-bold bg-pilkades-100 hover:bg-pilkades-200 text-pilkades-800 px-3 py-1.5 rounded-lg border border-pilkades-300">
                            <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Isi NIK Otomatis
                        </button>
                        <button onclick="fillDemoUndangan()" class="btn-tactile text-xs font-bold bg-amber-100 hover:bg-amber-200 text-amber-900 px-3 py-1.5 rounded-lg border border-amber-300">
                            <i class="fa-solid fa-ticket mr-1"></i> No. Undangan C6
                        </button>
                    </div>
                    <div class="text-xs font-mono text-slate-500" id="live-clock">
                        --:--:-- WIB
                    </div>
                </div>
            </div>

            <!-- Kolom Kanan (5 Kolom di Landscape): Keypad Numerik Layar Sentuh -->
            <div class="lg:col-span-5 p-5 sm:p-6 bg-slate-50 flex flex-col justify-center">
                <div class="grid grid-cols-3 gap-2.5 sm:gap-3">
                    <button onclick="pressKey('1')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">1</button>
                    <button onclick="pressKey('2')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">2</button>
                    <button onclick="pressKey('3')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">3</button>
                    
                    <button onclick="pressKey('4')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">4</button>
                    <button onclick="pressKey('5')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">5</button>
                    <button onclick="pressKey('6')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">6</button>
                    
                    <button onclick="pressKey('7')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">7</button>
                    <button onclick="pressKey('8')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">8</button>
                    <button onclick="pressKey('9')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">9</button>
                    
                    <button onclick="clearInput()" class="btn-tactile h-14 sm:h-16 bg-rose-50 hover:bg-rose-100 text-rose-700 text-sm sm:text-base font-extrabold rounded-2xl shadow-sm border border-rose-200 uppercase">
                        Reset
                    </button>
                    <button onclick="pressKey('0')" class="btn-tactile h-14 sm:h-16 bg-white hover:bg-pilkades-50 active:bg-pilkades-600 active:text-white text-slate-800 text-2xl font-extrabold rounded-2xl shadow-sm border border-slate-200">0</button>
                    <button onclick="backspaceKey()" class="btn-tactile h-14 sm:h-16 bg-amber-50 hover:bg-amber-100 text-amber-800 text-xl font-extrabold rounded-2xl shadow-sm border border-amber-200 flex items-center justify-center">
                        <i class="fa-solid fa-delete-left"></i>
                    </button>
                </div>

                <!-- Tombol Utama Masuk Bilik Suara -->
                <button onclick="enterVotingBooth()" class="btn-tactile mt-4 w-full py-4 px-6 bg-gradient-to-r from-pilkades-700 to-pilkades-600 hover:from-pilkades-800 hover:to-pilkades-700 text-white font-black text-base sm:text-lg rounded-2xl shadow-lg shadow-pilkades-600/30 flex items-center justify-center gap-3 uppercase tracking-wide">
                    <span>Masuk Bilik Suara</span>
                    <i class="fa-solid fa-arrow-right-to-bracket text-xl"></i>
                </button>
            </div>
        </section>

        <!-- -----------------------------------------------------------------
             SCREEN 2: SURAT SUARA DIGITAL (BILIK PEMILIHAN - 2 CALON WANITA)
             ----------------------------------------------------------------- -->
        <section id="screen-ballot" class="hidden w-full flex-col gap-4">
            <!-- Bar Identitas Surat Suara Berwarna Hijau -->
            <div class="bg-pilkades-800 text-white rounded-2xl px-5 py-3 shadow-md flex flex-wrap items-center justify-between gap-2 border-b-4 border-pilkades-500">
                <div class="flex items-center gap-3">
                    <span class="bg-white text-pilkades-900 font-black px-3 py-1 rounded-lg text-xs sm:text-sm uppercase">Surat Suara Sah</span>
                    <span class="font-bold text-sm sm:text-base">Pilih Salah Satu Calon Kepala Desa Karang Mukti</span>
                </div>
                <div class="flex items-center gap-3 text-xs sm:text-sm">
                    <span class="bg-pilkades-950/60 px-3 py-1 rounded-lg font-mono">Pemilih: <strong id="active-voter-display" class="text-amber-300">---</strong></span>
                    <button onclick="cancelVoting()" class="btn-tactile bg-white/15 hover:bg-white/25 px-3 py-1 rounded-lg font-semibold">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Keluar
                    </button>
                </div>
            </div>

            <!-- Grid 2 Kandidat Bersampingan (Calon 01 Diperbesar Dominan 8 Kolom, Calon 02 Diperkecil 4 Kolom dengan Foto 30%) -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6 items-stretch">
                
                <!-- KARTU CALON NOMOR URUT 01: IBU TARSIH, S.Pd. (SANGAT BESAR - 8 KOLOM) -->
                <div onclick="selectCandidate(1)" class="md:col-span-8 btn-tactile cursor-pointer group bg-white rounded-3xl shadow-2xl border-4 border-pilkades-600 ring-4 ring-pilkades-500/20 overflow-hidden flex flex-col justify-between transition-all">
                    <!-- Header Nomor Urut Hijau -->
                    <div class="bg-gradient-to-r from-pilkades-900 via-pilkades-700 to-pilkades-600 text-white px-6 py-4 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <span class="bg-amber-400 text-pilkades-950 text-xs sm:text-sm font-black px-3 py-1 rounded-lg uppercase tracking-wide shadow-sm">Calon Utama</span>
                            <span class="text-sm sm:text-base font-extrabold uppercase tracking-widest opacity-95">Kepala Desa</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs sm:text-sm font-bold uppercase">Nomor Urut</span>
                            <span class="bg-white text-pilkades-900 font-black text-4xl sm:text-5xl w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center shadow-lg">01</span>
                        </div>
                    </div>

                    <!-- Foto Kandidat 01 JPG Sangat Besar & Menonjol -->
                    <div class="p-6 sm:p-8 flex flex-col items-center justify-center bg-gradient-to-b from-pilkades-50/90 to-white flex-1">
                        <div class="relative w-72 h-[380px] sm:w-80 sm:h-[440px] rounded-3xl overflow-hidden border-4 border-pilkades-700 shadow-2xl bg-red-700">
                            <!-- Elemen IMG berformat JPG permanen -->
                            <img id="img-candidate-1" src="unduhan/gambarcalon_1" alt="Calon 01 Ibu Tarsih, S.Pd." class="w-full h-full object-cover object-top">
                            <div class="absolute bottom-0 inset-x-0 bg-pilkades-900/95 text-white text-sm font-extrabold text-center py-2 tracking-wider uppercase">
                                Calon No. Urut 01
                            </div>
                        </div>

                        <!-- Nama Lengkap Kandidat 01 -->
                        <div class="mt-5 text-center">
                            <h3 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
                                Ibu Tarsih, S.Pd.
                            </h3>
                            <p class="text-base sm:text-lg font-bold text-pilkades-700 mt-1">
                                Calon Kepala Desa Karang Mukti
                            </p>
                        </div>
                    </div>

                    <!-- Tombol Coblos Hijau Besar -->
                    <div class="p-6 pt-0">
                        <button type="button" class="w-full py-5 sm:py-6 bg-gradient-to-r from-pilkades-700 via-pilkades-600 to-emerald-500 group-hover:from-pilkades-800 group-hover:to-pilkades-600 text-white font-black text-xl sm:text-2xl rounded-2xl shadow-xl shadow-pilkades-600/30 flex items-center justify-center gap-3 uppercase tracking-wider">
                            <i class="fa-solid fa-check-to-slot text-3xl"></i>
                            <span>Coblos / Pilih No. 01</span>
                        </button>
                    </div>
                </div>

                <!-- KARTU CALON NOMOR URUT 02: tanpa nama (DIPERKECIL 4 KOLOM, GAMBAR 30%) -->
                <div onclick="selectCandidate(2)" class="md:col-span-4 btn-tactile cursor-pointer group bg-white rounded-3xl shadow-md border-2 border-slate-300 hover:border-pilkades-600 overflow-hidden flex flex-col justify-between transition-all my-auto">
                    <!-- Header Nomor Urut -->
                    <div class="bg-gradient-to-r from-slate-700 to-slate-600 group-hover:from-pilkades-800 group-hover:to-pilkades-600 text-white px-4 py-2.5 flex items-center justify-between transition-colors">
                        <span class="text-xs font-bold uppercase tracking-wider opacity-90">Calon Kades</span>
                        <div class="flex items-center gap-2">
                            <span class="text-[11px] font-bold uppercase">No. Urut</span>
                            <span class="bg-white text-slate-900 font-black text-xl w-9 h-9 rounded-xl flex items-center justify-center shadow">02</span>
                        </div>
                    </div>

                    <!-- Foto Kandidat 02 Diperkecil hingga 30% dari skala Calon 01 -->
                    <div class="p-4 flex flex-col items-center justify-center bg-gradient-to-b from-slate-50 to-white flex-1">
                        <div class="relative w-24 h-[132px] sm:w-28 sm:h-[140px] rounded-xl overflow-hidden border-2 border-slate-400 group-hover:border-pilkades-600 shadow bg-slate-200">
                            <!-- Elemen IMG berformat JPG permanen -->
                            <img id="img-candidate-2" src="" alt="Calon 02 tanpa nama" class="w-full h-full object-cover object-top">
                            <div class="absolute bottom-0 inset-x-0 bg-slate-800/85 text-white text-[9px] font-bold text-center py-0.5 tracking-wider uppercase">
                                No. 02
                            </div>
                        </div>

                        <!-- Nama Kandidat 02 -->
                        <div class="mt-3 text-center">
                            <h3 class="text-base sm:text-lg font-black text-slate-800 tracking-tight">
                                tanpa nama
                            </h3>
                            <p class="text-[11px] font-semibold text-slate-500 mt-0.5">
                                Calon Kepala Desa Karang Mukti
                            </p>
                        </div>
                    </div>

                    <!-- Tombol Coblos -->
                    <div class="p-4 pt-0">
                        <button type="button" class="w-full py-3 bg-slate-700 group-hover:bg-pilkades-600 text-white font-extrabold text-xs sm:text-sm rounded-xl shadow flex items-center justify-center gap-2 uppercase tracking-wider transition-colors">
                            <i class="fa-solid fa-check-to-slot text-base"></i>
                            <span>Coblos / Pilih No. 02</span>
                        </button>
                    </div>
                </div>

            </div>
        </section>

        <!-- -----------------------------------------------------------------
             SCREEN 3: CETAK OTOMATIS STRUK THERMAL BLUETOOTH & SELESAI
             ----------------------------------------------------------------- -->
        <section id="screen-receipt" class="hidden w-full bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden grid-cols-1 lg:grid-cols-12">
            
