    <!-- =====================================================================
         JAVASCRIPT LOGIKA APLIKASI, WEB AUDIO API, & PRINTER THERMAL BLUETOOTH
         ===================================================================== -->
    <script>
        /* ---------------------------------------------------------------------
           1. STATE APLIKASI & DATA KANDIDAT
           --------------------------------------------------------------------- */
        const state = {
            currentInput: '',
            activeVoterId: '',
            selectedCandidate: null,
            audioEnabled: true,
            btCharacteristic: null, // Menyimpan karakteristik Web Bluetooth printer jika terhubung
            btDeviceName: '',
            votes: { 1: 0, 2: 0 },
            usedVoters: new Set(),
            candidates: {
                1: {
                    number: '01',
                    name: 'Ibu Tarsih, S.Pd.',
                    subtitle: 'Calon Kepala Desa Karang Mukti',
                    photoJpg: '' // Akan diisi dataURL berformat image/jpeg
                },
                2: {
                    number: '02',
                    name: 'Bapak H. Ahmad Sudrajat',
                    subtitle: 'Calon Kepala Desa Karang Mukti',
                    photoJpg: '' // Akan diisi dataURL berformat image/jpeg
                }
            }
        };

        /* ---------------------------------------------------------------------
           2. GENERATOR & PENYIMPANAN PERMANEN FOTO KANDIDAT FORMAT .JPG
              Foto otomatis dimuat dari penyimpanan permanen (localStorage) dan
              dikunci permanen (photoLocked_1 & photoLocked_2) tepat setelah 1x diganti.
           --------------------------------------------------------------------- */
        const STORAGE_PHOTO_KEY_1 = 'pilkades_karang_mukti_permanent_photo_1_jpg';
        const STORAGE_PHOTO_KEY_2 = 'pilkades_karang_mukti_permanent_photo_2_jpg';
        const STORAGE_LOCK_KEY_1 = 'photoLocked_1';
        const STORAGE_LOCK_KEY_2 = 'photoLocked_2';

        function isCandidatePhotoLocked(candidateNum) {
            const key = candidateNum === 1 ? STORAGE_LOCK_KEY_1 : STORAGE_LOCK_KEY_2;
            return localStorage.getItem(key) === 'true';
        }

        function updatePhotoLockUI() {
            [1, 2].forEach((num) => {
                const locked = isCandidatePhotoLocked(num);
                const controlEl = document.getElementById(`upload-control-${num}`);
                const badgeEl = document.getElementById(`locked-badge-${num}`);
                const inputEl = document.getElementById(`input-photo-${num}`);

                if (locked) {
                    if (controlEl) controlEl.classList.add('hidden');
                    if (badgeEl) badgeEl.classList.remove('hidden');
                    if (inputEl) inputEl.disabled = true;
                } else {
                    if (controlEl) controlEl.classList.remove('hidden');
                    if (badgeEl) badgeEl.classList.add('hidden');
                    if (inputEl) inputEl.disabled = false;
                }
            });
        }

        function createDefaultPortraitJpg(candidateNum) {
            const w = candidateNum === 1 ? 480 : 320;
            const h = candidateNum === 1 ? 560 : 380;
            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');

            // Latar belakang resmi merah/hijau
            const grad = ctx.createLinearGradient(0, 0, 0, h);
            if (candidateNum === 1) {
                grad.addColorStop(0, '#b91c1c');
                grad.addColorStop(1, '#7f1d1d');
            } else {
                grad.addColorStop(0, '#1e3a8a');
                grad.addColorStop(1, '#1e293b');
            }
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, w, h);

            // Siluet potret resmi calon
            ctx.fillStyle = '#fde68a';
            ctx.beginPath();
            ctx.arc(w / 2, h * 0.34, w * 0.17, 0, Math.PI * 2);
            ctx.fill();

            // Pakaian / Kebaya atau Jas Resmi
            ctx.fillStyle = candidateNum === 1 ? '#065f46' : '#0f172a';
            ctx.beginPath();
            ctx.ellipse(w / 2, h * 0.82, w * 0.36, h * 0.32, 0, Math.PI, 0, false);
            ctx.fill();

            // Kerudung / Peci
            if (candidateNum === 1) {
                ctx.strokeStyle = '#fef3c7';
                ctx.lineWidth = w * 0.045;
                ctx.beginPath();
                ctx.arc(w / 2, h * 0.36, w * 0.19, Math.PI * 0.85, Math.PI * 0.15, false);
                ctx.stroke();
            } else {
                ctx.fillStyle = '#090d16';
                ctx.fillRect(w * 0.34, h * 0.14, w * 0.32, h * 0.09);
            }

            return canvas.toDataURL('image/jpeg', 0.92);
        }

        function loadOrGeneratePermanentPortraits() {
            const savedPhoto1 = localStorage.getItem(STORAGE_PHOTO_KEY_1);
            const savedPhoto2 = localStorage.getItem(STORAGE_PHOTO_KEY_2);

            if (savedPhoto1) {
                state.candidates[1].photoJpg = savedPhoto1;
            } else {
                state.candidates[1].photoJpg = createDefaultPortraitJpg(1);
                try {
                    localStorage.setItem(STORAGE_PHOTO_KEY_1, state.candidates[1].photoJpg);
                } catch (e) {}
            }

            if (savedPhoto2) {
                state.candidates[2].photoJpg = savedPhoto2;
            } else {
                state.candidates[2].photoJpg = createDefaultPortraitJpg(2);
                try {
                    localStorage.setItem(STORAGE_PHOTO_KEY_2, state.candidates[2].photoJpg);
                } catch (e) {}
            }

            applyCandidatePhotosToUI();
            updatePhotoLockUI();
        }

        function applyCandidatePhotosToUI() {
            const img1 = document.getElementById('img-candidate-1');
            const img2 = document.getElementById('img-candidate-2');
            const prev1 = document.getElementById('preview-admin-1');
            const prev2 = document.getElementById('preview-admin-2');

            if (img1 && state.candidates[1].photoJpg) img1.src = state.candidates[1].photoJpg;
            if (img2 && state.candidates[2].photoJpg) img2.src = state.candidates[2].photoJpg;
            if (prev1 && state.candidates[1].photoJpg) prev1.src = state.candidates[1].photoJpg;
            if (prev2 && state.candidates[2].photoJpg) prev2.src = state.candidates[2].photoJpg;
        }

        function handleCandidatePhotoUpload(candidateNum, event) {
            if (isCandidatePhotoLocked(candidateNum)) {
                playTone('error');
                updatePhotoLockUI();
                return;
            }

            const file = event.target.files && event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                const img = new Image();
                img.onload = function () {
                    // Kompresi & konversi ke JPG berkualitas tinggi agar ringan di localStorage
                    const maxW = candidateNum === 1 ? 640 : 320;
                    const scale = Math.min(1, maxW / img.width);
                    const canvas = document.createElement('canvas');
                    canvas.width = Math.round(img.width * scale);
                    canvas.height = Math.round(img.height * scale);

                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                    const jpgDataUrl = canvas.toDataURL('image/jpeg', 0.88);
                    state.candidates[candidateNum].photoJpg = jpgDataUrl;

                    const photoKey = candidateNum === 1 ? STORAGE_PHOTO_KEY_1 : STORAGE_PHOTO_KEY_2;
                    const lockKey = candidateNum === 1 ? STORAGE_LOCK_KEY_1 : STORAGE_LOCK_KEY_2;

                    try {
                        localStorage.setItem(photoKey, jpgDataUrl);
                        localStorage.setItem(lockKey, 'true');
                    } catch (err) {
                        console.warn('Penyimpanan lokal penuh:', err);
                    }

                    applyCandidatePhotosToUI();
                    updatePhotoLockUI();
                    playTone('success');
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        /* ---------------------------------------------------------------------
           3. EFEK SUARA SENTUH (WEB AUDIO API - TANPA FILE EKSTERNAL)
           --------------------------------------------------------------------- */
        let audioCtx = null;

        function playTone(type = 'tap') {
            if (!state.audioEnabled) return;
            try {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    audioCtx = new AudioContextClass();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;
                if (type === 'tap') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(680, now);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
                    osc.start(now);
                    osc.stop(now + 0.06);
                } else if (type === 'success') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.08);
                    osc.frequency.setValueAtTime(783.99, now + 0.16);
                    gain.gain.setValueAtTime(0.14, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                } else if (type === 'error') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.setValueAtTime(175, now + 0.12);
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                }
            } catch (e) {
                // Abaikan jika browser membatasi audio sebelum interaksi
            }
        }

        function toggleAudio() {
            state.audioEnabled = !state.audioEnabled;
            const icon = document.getElementById('audio-icon');
            if (icon) {
                icon.className = state.audioEnabled
                    ? 'fa-solid fa-volume-high text-base'
                    : 'fa-solid fa-volume-xmark text-base text-rose-300';
            }
            if (state.audioEnabled) playTone('tap');
        }

        /* ---------------------------------------------------------------------
           4. LOGIKA LAYAR LOGIN & KEYPAD NUMERIK PEMILIH
           --------------------------------------------------------------------- */
        function updateInputDisplay() {
            const inputEl = document.getElementById('voter-id-input');
            const counterEl = document.getElementById('digit-counter');
            if (inputEl) inputEl.value = state.currentInput;
            if (counterEl) counterEl.textContent = `${state.currentInput.length} / 16 Digit`;
        }

        function showLoginAlert(message, isError = true) {
            const alertEl = document.getElementById('login-alert');
            if (!alertEl) return;
            alertEl.textContent = message;
            alertEl.className = isError
                ? 'mt-3 p-3 rounded-xl text-sm font-semibold flex items-center gap-2 bg-rose-50 text-rose-800 border border-rose-200'
                : 'mt-3 p-3 rounded-xl text-sm font-semibold flex items-center gap-2 bg-emerald-50 text-emerald-800 border border-emerald-200';
            alertEl.classList.remove('hidden');
        }

        function hideLoginAlert() {
            const alertEl = document.getElementById('login-alert');
            if (alertEl) alertEl.classList.add('hidden');
        }

        function pressKey(digit) {
            playTone('tap');
            hideLoginAlert();
            if (state.currentInput.length < 16) {
                state.currentInput += digit;
                updateInputDisplay();
            }
        }

        function backspaceKey() {
            playTone('tap');
            hideLoginAlert();
            state.currentInput = state.currentInput.slice(0, -1);
            updateInputDisplay();
        }

        function clearInput() {
            playTone('tap');
            hideLoginAlert();
            state.currentInput = '';
            updateInputDisplay();
        }

        function fillDemoNIK() {
            playTone('tap');
            hideLoginAlert();
            const rand4 = Math.floor(1000 + Math.random() * 9000);
            state.currentInput = `321308120585${rand4}`;
            updateInputDisplay();
        }

        function fillDemoUndangan() {
            playTone('tap');
            hideLoginAlert();
            const rand3 = Math.floor(100 + Math.random() * 900);
            state.currentInput = `0010${rand3}`;
            updateInputDisplay();
        }

        function switchScreen(screenId) {
            const screens = ['screen-login', 'screen-ballot', 'screen-receipt'];
            screens.forEach((id) => {
                const el = document.getElementById(id);
                if (!el) return;
                if (id === screenId) {
                    el.classList.remove('hidden');
                    if (id === 'screen-ballot') el.classList.add('flex');
                    if (id === 'screen-receipt') el.classList.add('grid');
                } else {
                    el.classList.add('hidden');
                    el.classList.remove('flex', 'grid');
                }
            });
        }

        function enterVotingBooth() {
            const idVal = state.currentInput.trim();
            if (idVal.length < 6) {
                playTone('error');
                showLoginAlert('Masukkan minimal 6 digit Nomor Undangan (C6) atau 16 digit NIK yang sah.');
                return;
            }
            if (state.usedVoters.has(idVal)) {
                playTone('error');
                showLoginAlert(`NIK / Nomor Undangan (${idVal}) sudah digunakan untuk memilih!`);
                return;
            }

            playTone('success');
            state.activeVoterId = idVal;
            const activeDisplay = document.getElementById('active-voter-display');
            if (activeDisplay) activeDisplay.textContent = maskVoterId(idVal);
            switchScreen('screen-ballot');
        }

        function cancelVoting() {
            playTone('tap');
            state.activeVoterId = '';
            state.selectedCandidate = null;
            switchScreen('screen-login');
        }

        function maskVoterId(id) {
            if (id.length <= 6) return id;
            return id.slice(0, 4) + '********' + id.slice(-3);
        }

        /* ---------------------------------------------------------------------
           5. PEMILIHAN KANDIDAT & MODAL KONFIRMASI
           --------------------------------------------------------------------- */
        function selectCandidate(candidateNum) {
            playTone('tap');
            state.selectedCandidate = candidateNum;
            const cand = state.candidates[candidateNum];

            document.getElementById('confirm-candidate-img').src = cand.photoJpg;
            document.getElementById('confirm-candidate-num').textContent = cand.number;
            document.getElementById('confirm-num-text').textContent = cand.number;
            document.getElementById('confirm-candidate-name').textContent = cand.name;

            document.getElementById('modal-confirm').classList.remove('hidden');
        }

        function closeConfirmModal() {
            playTone('tap');
            document.getElementById('modal-confirm').classList.add('hidden');
        }

        function confirmVoteAndPrint() {
            const candNum = state.selectedCandidate;
            if (!candNum) return;

            closeConfirmModal();
            playTone('success');

            // Catat suara & tandai hak pilih sudah digunakan
            state.votes[candNum] = (state.votes[candNum] || 0) + 1;
            if (state.activeVoterId) {
                state.usedVoters.add(state.activeVoterId);
            }
            saveElectionTallies();

            // Siapkan data struk thermal 58mm
            const now = new Date();
            const pad = (n) => String(n).padStart(2, '0');
            const timeStr = `${pad(now.getDate())}/${pad(now.getMonth() + 1)}/${now.getFullYear()} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
            const receiptHash = `#KM-${Math.floor(1000 + Math.random() * 9000)}`;
            const cand = state.candidates[candNum];

            document.getElementById('receipt-time').textContent = `: ${timeStr}`;
            document.getElementById('receipt-voter').textContent = `: ${maskVoterId(state.activeVoterId)}`;
            document.getElementById('receipt-hash').textContent = `: ${receiptHash}`;
            document.getElementById('receipt-choice-label').textContent = `Pilihan: No. Urut ${cand.number} (${cand.name})`;

            renderReceiptQrSvg(receiptHash + '-' + cand.number);

            // Reset animasi kertas struk
            const paper = document.getElementById('printable-thermal-receipt');
            paper.classList.remove('thermal-paper-animate');
            void paper.offsetWidth;
            paper.classList.add('thermal-paper-animate');

            switchScreen('screen-receipt');
            triggerThermalPrint(false);
        }

        function renderReceiptQrSvg(seedText) {
            const svg = document.getElementById('receipt-qr-svg');
            if (!svg) return;
            let hash = 0;
            for (let i = 0; i < seedText.length; i++) {
                hash = (hash << 5) - hash + seedText.charCodeAt(i);
                hash |= 0;
            }
            let rects = '';
            for (let r = 0; r < 10; r++) {
                for (let c = 0; c < 10; c++) {
                    const isFinder = (r < 3 && c < 3) || (r < 3 && c > 6) || (r > 6 && c < 3);
                    const bit = ((Math.abs(hash + r * 31 + c * 17) % 3) === 0);
                    if (isFinder || bit) {
                        rects += `<rect x="${c * 10}" y="${r * 10}" width="9" height="9" fill="#0f172a"/>`;
                    }
                }
            }
            svg.innerHTML = rects;
        }

        /* ---------------------------------------------------------------------
           6. CETAK STRUK THERMAL BLUETOOTH (ESC/POS + DIALOG PRINT)
           --------------------------------------------------------------------- */
        async function connectBluetoothPrinter() {
            playTone('tap');
            const statusText = document.getElementById('bt-status-text');
            if (!navigator.bluetooth) {
                if (statusText) statusText.textContent = 'Printer BT: Mode Sistem';
                return;
            }
            try {
                const device = await navigator.bluetooth.requestDevice({
                    acceptAllDevices: true,
                    optionalServices: ['000018f0-0000-1000-8000-00805f9b34fb']
                });
                const server = await device.gatt.connect();
                const service = await server.getPrimaryService('000018f0-0000-1000-8000-00805f9b34fb');
                state.btCharacteristic = await service.getCharacteristic('00002af1-0000-1000-8000-00805f9b34fb');
                state.btDeviceName = device.name || 'POS-58BT';
                if (statusText) statusText.textContent = `BT: ${state.btDeviceName}`;
                playTone('success');
            } catch (err) {
                console.log('Koneksi Web Bluetooth dibatalkan/tidak tersedia:', err);
            }
        }

        async function triggerThermalPrint(manualTrigger = false) {
            const titleEl = document.getElementById('print-status-title');
            const descEl = document.getElementById('print-status-desc');
            const spinnerEl = document.getElementById('print-spinner');

            if (titleEl) titleEl.textContent = 'Mencetak Bukti Pilih ke Printer Mini Bluetooth...';
            if (descEl) descEl.textContent = 'Mengirim perintah ESC/POS 58mm otomatis';
            if (spinnerEl) {
                spinnerEl.className = 'w-8 h-8 rounded-full bg-pilkades-100 text-pilkades-700 flex items-center justify-center animate-spin';
                spinnerEl.innerHTML = '<i class="fa-solid fa-gear"></i>';
            }

            // Jika printer Web Bluetooth aktif, kirim teks ESC/POS langsung
            if (state.btCharacteristic) {
                try {
                    const encoder = new TextEncoder();
                    const receiptText =
                        '\x1B\x40' +
                        'PANITIA PILKADES KARANG MUKTI\n' +
                        'Kec. Cipeundeuy, Kab. Subang\n' +
                        '--------------------------------\n' +
                        'STATUS : SUARA SAH TERCATAT\n' +
                        document.getElementById('receipt-choice-label').textContent + '\n' +
                        '--------------------------------\n\n\n';
                    await state.btCharacteristic.writeValue(encoder.encode(receiptText));
                } catch (e) {
                    console.warn('Gagal kirim ESC/POS BT:', e);
                }
            }

            setTimeout(() => {
                if (titleEl) titleEl.textContent = 'Bukti Pilih Berhasil Dicetak!';
                if (descEl) descEl.textContent = 'Silakan ambil struk bukti dan lanjut ke pemilih berikutnya.';
                if (spinnerEl) {
                    spinnerEl.className = 'w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center';
                    spinnerEl.innerHTML = '<i class="fa-solid fa-check"></i>';
                }
                if (manualTrigger) {
                    window.print();
                }
            }, 1400);
        }

        function finishAndNextVoter() {
            playTone('tap');
            state.currentInput = '';
            state.activeVoterId = '';
            state.selectedCandidate = null;
            updateInputDisplay();
            hideLoginAlert();
            switchScreen('screen-login');
        }

        /* ---------------------------------------------------------------------
           7. PANEL PANITIA KPPS, PENYIMPANAN SUARA & INISIALISASI HALAMAN
           --------------------------------------------------------------------- */
        const STORAGE_VOTES_KEY = 'pilkades_karang_mukti_votes_v1';

        function loadElectionTallies() {
            try {
                const raw = localStorage.getItem(STORAGE_VOTES_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    state.votes = parsed.votes || { 1: 0, 2: 0 };
                    state.usedVoters = new Set(parsed.usedVoters || []);
                }
            } catch (e) {}
        }

        function saveElectionTallies() {
            try {
                localStorage.setItem(
                    STORAGE_VOTES_KEY,
                    JSON.stringify({
                        votes: state.votes,
                        usedVoters: Array.from(state.usedVoters)
                    })
                );
            } catch (e) {}
        }

        function updateCommitteeDashboard() {
            const v1 = state.votes[1] || 0;
            const v2 = state.votes[2] || 0;
            const total = v1 + v2;
            const pct1 = total > 0 ? ((v1 / total) * 100).toFixed(1) : '0';
            const pct2 = total > 0 ? ((v2 / total) * 100).toFixed(1) : '0';

            document.getElementById('admin-total-votes').textContent = total;
            document.getElementById('admin-votes-1').textContent = v1;
            document.getElementById('admin-pct-1').textContent = `${pct1}%`;
            document.getElementById('admin-votes-2').textContent = v2;
            document.getElementById('admin-pct-2').textContent = `${pct2}%`;
        }

        function openCommitteeModal() {
            playTone('tap');
            applyCandidatePhotosToUI();
            updatePhotoLockUI();
            updateCommitteeDashboard();
            document.getElementById('modal-committee').classList.remove('hidden');
        }

        function closeCommitteeModal() {
            playTone('tap');
            document.getElementById('modal-committee').classList.add('hidden');
        }

        function resetAllElectionData() {
            playTone('tap');
            // Hanya mereset data suara & daftar NIK simulasi; foto kandidat yang terkunci tetap permanen!
            state.votes = { 1: 0, 2: 0 };
            state.usedVoters.clear();
            localStorage.removeItem(STORAGE_VOTES_KEY);
            updateCommitteeDashboard();
            playTone('success');
        }

        function startLiveClock() {
            const clockEl = document.getElementById('live-clock');
            const tick = () => {
                if (!clockEl) return;
                const now = new Date();
                const pad = (n) => String(n).padStart(2, '0');
                clockEl.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())} WIB`;
            };
            tick();
            setInterval(tick, 1000);
        }

        // Dukungan keyboard fisik/Bluetooth selain layar sentuh
        document.addEventListener('keydown', (e) => {
            const loginVisible = !document.getElementById('screen-login').classList.contains('hidden');
            const modalHidden =
                document.getElementById('modal-confirm').classList.contains('hidden') &&
                document.getElementById('modal-committee').classList.contains('hidden');

            if (loginVisible && modalHidden) {
                if (e.key >= '0' && e.key <= '9') {
                    pressKey(e.key);
                } else if (e.key === 'Backspace') {
                    backspaceKey();
                } else if (e.key === 'Enter') {
                    enterVotingBooth();
                }
            }
        });

        window.addEventListener('DOMContentLoaded', () => {
            loadElectionTallies();
            loadOrGeneratePermanentPortraits();
            updateInputDisplay();
            startLiveClock();
        });
    </script>
